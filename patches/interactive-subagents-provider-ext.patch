+/** Map an extension-registered model provider (`provider/model`) to its package dir. */
+function getProviderExtensionPath(model: string | null | undefined): string | undefined {
+  const provider = model?.split("/")[0];
+  const map: Record<string, string> = {
+    "claude-bridge": join(getAgentConfigDir(), "npm", "node_modules", "pi-claude-bridge"),
+  };
+  const path = provider ? map[provider] : undefined;
+  return path && existsSync(path) ? path : undefined;
+}
+
+/** Installed safety extensions that every sandboxed child must load. */
+function getGuardExtensionPaths(): string[] {
+  const npmDir = join(getAgentConfigDir(), "npm", "node_modules");
+  return [join(npmDir, "@aliou", "pi-guardrails"), join(npmDir, "pi-sandbox")].filter((path) =>
+    existsSync(path),
+  );
+}
